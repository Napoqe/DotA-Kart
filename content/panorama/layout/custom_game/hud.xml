<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/hud.css" />
    </styles>

    <scripts>
        <include src="file://{resources}/scripts/custom_game/hud.js" />
        <include src="file://{resources}/scripts/custom_game/dotakart_camera.js" />
        <include src="file://{resources}/scripts/custom_game/dotakart_input.js" />
    </scripts>

    <!--
        IMPORTANTE PARA DOTA 2 PANORAMA:
        O primeiro Panel real do arquivo não pode ter id="...".
        Por isso existe este Panel raiz sem id, e o HUD verdadeiro fica dentro dele.
    -->
    <Panel class="DotaKartHUDRoot" hittest="false" hittestchildren="true">
        <Panel id="DotaKartHUD" hittest="false" hittestchildren="true">
            <!-- Topo: volta, item e tempo -->
            <Panel id="DKTopHud" hittest="false">
                <Panel id="DKLapBox" class="DKBox" hittest="false">
                    <Label id="DKLapTitle" text="LAP" />
                    <Label id="DKLapText" text="1/3" />
                </Panel>

                <Panel id="DKItemBox" class="DKBox NoItem" hittest="false">
                    <DOTAItemImage id="DKItemImage" itemname="" />
                    <DOTAAbilityImage id="DKAbilityImage" abilityname="" />
                    <Image id="DKCustomItemImage" src="" />
                    <Label id="DKItemEmpty" text="?" />
                    <Label id="DKItemCharges" text="" />
                    <Panel id="DKItemInfoPanel" hittest="false">
                        <Label id="DKItemName" text="" />
                        <Label id="DKItemDesc" text="" />
                    </Panel>
                </Panel>

                <Panel id="DKTimerBox" class="DKBox" hittest="false">
                    <Label id="DKTimerTitle" text="TIME" />
                    <Label id="DKTimerText" text="00:00.00" />
                </Panel>
            </Panel>

            <!-- Ranking vertical no lado esquerdo -->
            <Panel id="DKStandings" hittest="false" />

            <!-- Posição grande no canto inferior esquerdo -->
            <Panel id="DKPlaceBox" hittest="false">
                <Label id="DKPlaceNumber" text="1" />
                <Label id="DKPlaceSuffix" text="st" />
            </Panel>

            <!-- Mini mapa estilizado no canto inferior direito -->
            <Panel id="DKMiniMap" hittest="false">
                <Panel id="DKMiniTrack" hittest="false">
                    <Panel id="DKMiniTrackLines" hittest="false" />
                    <Panel id="DKMiniRacerMarkers" hittest="false" />
                    <Panel id="DKMiniMarker" hittest="false" />
                </Panel>
            </Panel>

            <Panel id="DKDebugBox" hittest="false">
                <Label id="DKDebugText" text="" />
            </Panel>



            <!-- FIX58: configuracao pre-corrida pelo jogador 1/host. -->
            <Panel id="DKHostSetupPanel" class="DKHostSetupPanel" hittest="true">
                <Label id="DKHostSetupTitle" text="DOTA KART RACE SETUP" />
                <Label id="DKHostSetupStatus" text="Host: choose laps" />
                <Panel id="DKHostLapButtons" class="DKHostLapButtons" hittest="true">
                    <Button id="DKHostLap2" class="DKHostLapButton" hittest="true"><Label text="2" /></Button>
                    <Button id="DKHostLap3" class="DKHostLapButton" hittest="true"><Label text="3" /></Button>
                    <Button id="DKHostLap4" class="DKHostLapButton" hittest="true"><Label text="4" /></Button>
                    <Button id="DKHostLap5" class="DKHostLapButton" hittest="true"><Label text="5" /></Button>
                </Panel>
                <Label id="DKHostSetupHint" text="Empty slots will be filled by AI bots." />
            </Panel>

            <!-- FIX55: textos grandes de stun/efeitos visíveis na câmera MK64. -->
            <Panel id="DKFloatingTextRoot" hittest="false" />

            <!-- FIX50: contagem de largada. Aparece grande só nos últimos 3 segundos e GO. -->
            <Panel id="DKCountdownScreen" hittest="false">
                <Label id="DKCountdownText" text="" />
            </Panel>

            <!-- FIX43: tela/placar de chegada local para quem terminou. -->
            <Panel id="DKFinishScreen" hittest="false">
                <Panel id="DKFinishPanel" hittest="false">
                    <Label id="DKFinishTitle" text="RACE FINISH" />
                    <Label id="DKFinishSubtitle" text="Finished racers" />
                    <Panel id="DKFinishRows" hittest="false" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
